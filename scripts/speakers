#!/usr/bin/env -S uv run --quiet --script
# /// script
# requires-python = ">=3.10"
# dependencies = ["sherpa-onnx>=1.10", "numpy", "soundfile"]
# ///
"""speakers — label who spoke when, offline, and merge it with a whisper.cpp transcript.

    speakers AUDIO [-n NUM_SPEAKERS]

Reads AUDIO and the whisper.cpp word-level JSON beside it (AUDIO-base.json, written by
`transcribe`), finds speaker turns with sherpa-onnx (pyannote segmentation + WeSpeaker
voice embeddings), and rewrites AUDIO-base.txt as:

    [00:01:23] Speaker 1: words...

Nothing leaves this Mac. Models live in ~/Models/speakers.
"""
import argparse
import json
import os
import subprocess
import sys
import tempfile
from pathlib import Path

import numpy as np
import sherpa_onnx
import soundfile as sf

MODELS = Path(os.environ.get("SPEAKER_MODEL_DIR", Path.home() / "Models/speakers"))
SEGMENTATION = MODELS / "sherpa-onnx-pyannote-segmentation-3-0/model.int8.onnx"
EMBEDDING = MODELS / "wespeaker_en_voxceleb_resnet34_LM.onnx"

# Tested on a 14-minute, 3-person call: 0.5 found 9 "speakers", 0.7 found the real ones.
DEFAULT_THRESHOLD = 0.7
# A "speaker" with less than this share of the talking is almost always a voice split in two.
MIN_SHARE = 0.02
SENTENCE_END = (".", "?", "!")


def write_atomic(path: Path, text: str) -> None:
    """Replace path with text so a concurrent reader sees the old file or the new one, never a
    truncated or half-written one: write a temp file beside it, fsync, then os.replace."""
    fd, tmp = tempfile.mkstemp(dir=path.parent, prefix=f".{path.name}.", suffix=".tmp")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(text)
            f.flush()
            os.fsync(f.fileno())
        try:
            os.chmod(tmp, path.stat().st_mode & 0o7777)
        except FileNotFoundError:
            os.chmod(tmp, 0o644)
        os.replace(tmp, path)
    except BaseException:
        try:
            os.unlink(tmp)
        except FileNotFoundError:
            pass
        raise


def load_16k_mono(path: Path) -> np.ndarray:
    with tempfile.TemporaryDirectory() as tmp:
        wav = Path(tmp) / "in.wav"
        subprocess.run(["ffmpeg", "-hide_banner", "-loglevel", "error", "-y", "-i", str(path),
                        "-ac", "1", "-ar", "16000", "-c:a", "pcm_s16le", str(wav)], check=True)
        audio, _ = sf.read(wav, dtype="float32")
    return audio


def diarize(audio: np.ndarray, num_speakers: int, threshold: float, provider: str):
    config = sherpa_onnx.OfflineSpeakerDiarizationConfig(
        segmentation=sherpa_onnx.OfflineSpeakerSegmentationModelConfig(
            pyannote=sherpa_onnx.OfflineSpeakerSegmentationPyannoteModelConfig(model=str(SEGMENTATION)),
            num_threads=8,
            provider=provider,
        ),
        embedding=sherpa_onnx.SpeakerEmbeddingExtractorConfig(
            model=str(EMBEDDING), num_threads=8, provider=provider),
        clustering=sherpa_onnx.FastClusteringConfig(num_clusters=num_speakers, threshold=threshold),
        min_duration_on=0.3,
        min_duration_off=0.5,
    )
    if not config.validate():
        sys.exit("speakers: model files missing or invalid in " + str(MODELS))
    sd = sherpa_onnx.OfflineSpeakerDiarization(config)
    return [(s.start, s.end, s.speaker) for s in sd.process(audio).sort_by_start_time()]


def drop_tiny_speakers(turns):
    """Give turns of speakers with almost no talk time to the nearest real speaker."""
    talk: dict[int, float] = {}
    for start, end, spk in turns:
        talk[spk] = talk.get(spk, 0) + end - start
    total = sum(talk.values()) or 1
    real = {s for s, t in talk.items() if t / total >= MIN_SHARE} or set(talk)
    kept = [t for t in turns if t[2] in real]
    out = []
    for start, end, spk in turns:
        if spk not in real:
            mid = (start + end) / 2
            spk = min(kept, key=lambda k: min(abs(mid - k[0]), abs(mid - k[1])))[2]
        out.append((start, end, spk))
    return out


def words_from_whisper(json_path: Path):
    """Whisper tokens → words with start/end seconds. Tokens that start with a space begin a new word."""
    data = json.loads(json_path.read_text(encoding="utf-8", errors="replace"))
    words = []
    for seg in data.get("transcription", []):
        for tok in seg.get("tokens", []):
            text = tok.get("text", "")
            if not text or text.startswith("[_"):
                continue
            start, end = tok["offsets"]["from"] / 1000, tok["offsets"]["to"] / 1000
            if words and not text.startswith(" "):
                words[-1][0] += text
                words[-1][2] = end
            else:
                words.append([text.strip(), start, end])
    return [w for w in words if w[0]]


def speaker_at(t: float, turns) -> int:
    best, best_gap = turns[0][2], float("inf")
    for start, end, spk in turns:
        if start <= t <= end:
            return spk
        gap = min(abs(t - start), abs(t - end))
        if gap < best_gap:
            best, best_gap = spk, gap
    return best


def stamp(t: float) -> str:
    t = int(t)
    return f"{t // 3600:02d}:{t // 60 % 60:02d}:{t % 60:02d}"


def main():
    ap = argparse.ArgumentParser(description="Label speakers in a whisper.cpp transcript, offline.")
    ap.add_argument("audio", type=Path)
    ap.add_argument("-n", "--num-speakers", type=int, default=-1, help="exact number of speakers (default: auto)")
    ap.add_argument("-t", "--threshold", type=float, default=DEFAULT_THRESHOLD,
                    help=f"auto mode: lower finds more speakers, higher fewer (default {DEFAULT_THRESHOLD})")
    args = ap.parse_args()

    base = args.audio.with_suffix("")
    json_path, txt_path = Path(f"{base}.json"), Path(f"{base}.txt")
    if not json_path.exists():
        sys.exit(f"speakers: no word timings at {json_path}; run transcribe first")

    words = words_from_whisper(json_path)
    if not words:
        sys.exit("speakers: transcript is empty")
    audio = load_16k_mono(args.audio)
    try:
        # CoreML runs on the Mac's GPU / Neural Engine, about twice as fast as CPU.
        turns = diarize(audio, args.num_speakers, args.threshold, "coreml")
    except Exception as e:
        print(f"speakers: CoreML failed ({e}); using CPU", file=sys.stderr)
        turns = diarize(audio, args.num_speakers, args.threshold, "cpu")
    if not turns:
        print("speakers: no speech turns found; transcript left as is", file=sys.stderr)
        return
    if args.num_speakers <= 0:  # sherpa-onnx clusters by threshold for any n <= 0
        turns = drop_tiny_speakers(turns)

    # Split into sentences, and give each sentence to whoever spoke most of it, so a
    # speaker change never lands mid-sentence because of a slightly-off word timing.
    sentences, cur = [], []
    for w in words:
        cur.append(w)
        if w[0].endswith(SENTENCE_END):
            sentences.append(cur)
            cur = []
    if cur:
        sentences.append(cur)

    # Number speakers in the order they first talk: Speaker 1, Speaker 2, ...
    order: dict[int, int] = {}
    lines, current, buf, started = [], None, [], 0.0
    for sent in sentences:
        share: dict[int, float] = {}
        for _, start, end in sent:
            spk = speaker_at((start + end) / 2, turns)
            share[spk] = share.get(spk, 0) + max(end - start, 0.01)
        label = order.setdefault(max(share, key=share.get), len(order) + 1)
        if label != current:
            if buf:
                lines.append(f"[{stamp(started)}] Speaker {current}: {' '.join(buf)}")
            current, buf, started = label, [], sent[0][1]
        buf += [w[0] for w in sent]
    if buf:
        lines.append(f"[{stamp(started)}] Speaker {current}: {' '.join(buf)}")

    write_atomic(txt_path, "\n\n".join(lines) + "\n")
    print(f"speakers: {len(order)} speaker(s), {len(lines)} turns → {txt_path}", file=sys.stderr)


if __name__ == "__main__":
    main()
