#!/usr/bin/env python3
"""Gate for the GitHub front page and the docs behind it.

README.md is a product page: a pitch with screenshots, no emoji, no install commands, short. The detail lives in
docs/INSTALL.md, GUIDE.md, PRIVACY.md, AGENTS.md and DEVELOPMENT.md, which must keep every command and every
honest caveat. Run: python3 -I scripts/readme-check
It checks what a program can check; a reviewer reads the prose. It fails itself if too few checks ran.
"""
import colorsys
import os
import re
import struct
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
FLOOR = 164
checks = 0
failures = 0
DOCS = ["INSTALL", "GUIDE", "PRIVACY", "AGENTS", "DEVELOPMENT"]
EMOJI = re.compile("[\U0001F000-\U0001FAFF☀-➿⬀-⯿️‍⌨⏩-⏿]")


def check(name, ok, detail=""):
    global checks, failures
    checks += 1
    print("PASS" if ok else "FAIL", name)
    if not ok:
        failures += 1
        if detail != "":
            print("   ", str(detail)[:300])


def png_width(path):
    with open(path, "rb") as f:
        head = f.read(24)
    return struct.unpack(">I", head[16:20])[0] if head[:8] == b"\x89PNG\r\n\x1a\n" else 0


def read(rel):
    p = os.path.join(ROOT, rel)
    return open(p, encoding="utf-8").read() if os.path.exists(p) else None


def prose_lines(text):
    out, fence = [], False
    for ln in text.splitlines():
        if ln.strip().startswith("```"):
            fence = not fence
            continue
        if not fence:
            out.append(ln)
    return out


def headings(text):
    return [l for l in prose_lines(text) if re.match(r"^#{1,6} ", l)]


def local_targets(text):
    refs = re.findall(r"\]\(([^)\s]+)\)", text) + re.findall(r'(?:href|src)="([^"]+)"', text)
    return [r for r in refs if not r.startswith(("http://", "https://", "mailto:", "#", "data:"))]


readme = read("README.md")
if readme is None:
    print("FAIL README.md does not exist")
    sys.exit(1)
rl = readme.lower()
rlines = readme.splitlines()
rh = headings(readme)

# MARK: README is a short product page
check("README is between 50 and 170 lines", 50 <= len(rlines) <= 170, len(rlines))
words = len(re.findall(r"[A-Za-z0-9'’]+", " ".join(prose_lines(readme))))
check("README is between 250 and 750 words of prose", 250 <= words <= 750, words)
check("exactly one H1", sum(1 for h in rh if h.startswith("# ")) == 1)
h2 = [h for h in rh if h.startswith("## ")]
check("between 5 and 11 sections (H2)", 5 <= len(h2) <= 11, len(h2))
check("no H3 or deeper headings: it is flat, like a product page", not any(re.match(r"^#{3,6} ", h) for h in rh), [h for h in rh if h.startswith("###")])
check("no code blocks in the README: commands belong in the docs", "```" not in readme)
check("no install or build commands in the README",
      not any(c in readme for c in ["brew install", "curl ", "swiftc", "bash EarshotApp", "uv run", "git clone"]))
check("no tables in the README", not any(l.strip().startswith("|") for l in prose_lines(readme)))
check("no emoji or icon characters in the README", not EMOJI.search(readme), EMOJI.findall(readme)[:8])
badge_refs = sorted(set(re.findall(r"assets/badges/[A-Za-z0-9_.-]+\.svg", readme)))
check("README shows the badge row: at least 6 badges from assets/badges/", len(badge_refs) >= 6, badge_refs)
check("every badge file exists", bool(badge_refs) and all(os.path.exists(os.path.join(ROOT, b)) for b in badge_refs), badge_refs)
oldcolours = [c for b in badge_refs if os.path.exists(os.path.join(ROOT, b)) for c in ("5b5bf0", "7a5bf0", "2a1a7a")
              if c in open(os.path.join(ROOT, b), encoding="utf-8").read().lower()]
check("no badge uses the old indigo or violet", not oldcolours, oldcolours)
first_badge = readme.find("assets/badges/")
first_section = readme.find("\n## ")
check("the badges sit in the header, before the first section", 0 <= first_badge < first_section, (first_badge, first_section))
check("README does not say it is unpublished", "not published" not in rl and "local repository" not in rl)
check("no placeholder text", not re.search(r"lorem ipsum|\bTODO\b|\bTBD\b", readme, re.I))

# MARK: the pitch has the things a product page needs
check("a download link to the latest release", "github.com/gaberger/earshot/releases/latest" in readme)
for d in DOCS:
    check("README links to docs/%s.md" % d, "docs/%s.md" % d in readme)
check("README links to the release notes", "docs/releases" in readme)
for phrase in ["Apple silicon", "macOS 26.4", "not notarized", "Open Anyway", "MCP", "Recordings", "Notes", "Dictation", "sample data"]:
    check("README says: %s" % phrase, phrase.lower() in rl)
check("README mentions search and the shortcut Command K", "search" in rl and ("⌘k" in rl or "⌘ k" in rl or "command k" in rl))
check("README states honestly that a connected agent receives what it reads", "agent" in rl and "privacy.md" in rl)

# MARK: images, links, logo
imgs = re.findall(r'<img\s+[^>]*?src="([^"]+)"[^>]*?alt="([^"]*)"', readme) + [(m[1], m[0]) for m in re.findall(r"!\[([^\]]*)\]\(([^)\s]+)", readme)]
local = [(s, a) for s, a in imgs if not s.startswith(("http://", "https://"))]
check("every image has alt text of 12 or more characters", all(len(a) >= 12 for _, a in local), [(s, a) for s, a in local if len(a) < 12])
shots = sorted({s for s, _ in local if s.startswith("assets/screenshots/")})
check("at least 5 different screenshots", len(shots) >= 5, shots)
check("every screenshot is at least 1000 px wide", all(png_width(os.path.join(ROOT, s)) >= 1000 for s in shots if os.path.exists(os.path.join(ROOT, s))))
check("the README uses assets/earshot-logo.png", any(s == "assets/earshot-logo.png" for s, _ in local))
check("every local image and link in the README exists", all(os.path.exists(os.path.join(ROOT, t.split("#")[0])) for t in local_targets(readme)),
      [t for t in local_targets(readme) if not os.path.exists(os.path.join(ROOT, t.split("#")[0]))])
logo_path = os.path.join(ROOT, "assets", "earshot-logo.png")
check("the logo is a PNG at least 400 px wide", os.path.exists(logo_path) and png_width(logo_path) >= 400)
check("the old flat logo file is gone", not os.path.exists(os.path.join(ROOT, "assets", "earshot-logo.svg")))
try:
    from PIL import Image
except ImportError:
    Image = None
check("Pillow is installed, so the logo pixels can be checked", Image is not None)
if Image is not None and os.path.exists(logo_path):
    im = Image.open(logo_path).convert("RGBA")
    w, h = im.size
    px = im.load()
    check("the logo is square with transparent corners", w == h and px[0, 0][3] == 0 and px[w - 1, h - 1][3] == 0, (w, h))
    samples = [px[x, y][:3] for y in range(0, h, 4) for x in range(0, w, 4) if px[x, y][3] > 200]
    lum = sorted(0.2126 * r + 0.7152 * g + 0.0722 * b for r, g, b in samples)
    check("the logo tile is dark", bool(lum) and lum[len(lum) // 2] < 70)
    orange = sum(1 for r, g, b in samples if 14 <= colorsys.rgb_to_hsv(r / 255, g / 255, b / 255)[0] * 360 <= 40
                 and colorsys.rgb_to_hsv(r / 255, g / 255, b / 255)[1] >= 0.5)
    check("the logo shows an orange ear and waves", orange >= 600, orange)

# MARK: the docs exist, are real, and keep the detail
minlines = {"INSTALL": 60, "GUIDE": 80, "PRIVACY": 15, "AGENTS": 30, "DEVELOPMENT": 30}
docs = {}
for d in DOCS:
    t = read("docs/%s.md" % d)
    docs[d] = t or ""
    check("docs/%s.md exists and is substantial" % d, t is not None and len(t.splitlines()) >= minlines[d], 0 if t is None else len(t.splitlines()))
    if t is not None:
        check("docs/%s.md has exactly one H1" % d, sum(1 for h in headings(t) if h.startswith("# ")) == 1)
        check("docs/%s.md has no emoji" % d, not EMOJI.search(t), EMOJI.findall(t)[:6])
        bad = [x for x in local_targets(t) if not os.path.exists(os.path.normpath(os.path.join(ROOT, "docs", x.split("#")[0])))]
        check("every local link and image in docs/%s.md resolves" % d, not bad, bad)

I, G, P, A, D = (docs[k] for k in DOCS)
for cmd in ["brew install whisper-cpp ffmpeg uv", "ggml-large-v3-turbo.bin", "ggml-silero-v5.1.2.bin", "ggml-large-v3-q5_0.bin",
            "sherpa-onnx-pyannote-segmentation-3-0.tar.bz2", "wespeaker_en_voxceleb_resnet34_LM.onnx", "speaker-recongition-models",
            "bash EarshotApp/build.sh", "Open Anyway", "not notarized", "Apple silicon", "macOS 26.4", "Apple Intelligence", "Uninstall",
            "Check that it works", "~/Models/whisper"]:
    check("INSTALL keeps: %s" % cmd, cmd in I)
for phrase in ["Tap to start, tap to stop", "Fix words it mishears", "Tidy up what I say", "Highlight the window", "Press Return after typing",
               "Dictation", "Notes", "exclamation point", "Summary templates", "Shortcuts", "Accuracy", "Command line", "```mermaid", "sidebar", "sample data"]:
    check("GUIDE keeps: %s" % phrase, phrase in G or (phrase == "sample data" and "sample data" in rl))
check("GUIDE documents search with Command K", re.search(r"<kbd>⌘</kbd>\s*<kbd>K</kbd>|⌘K", G) is not None)
check("GUIDE documents going back from an open recording", "Esc" in G and "⌘</kbd> <kbd>[" in G)
for phrase in ["agent", "provider", "clipboard", "Private Cloud Compute"]:
    check("PRIVACY says: %s" % phrase, phrase.lower() in P.lower())
for phrase in ["earshot-mcp", "earshot-speak", "read-only", "untrusted", "list_recordings", "get_transcript", "get_summary"]:
    check("AGENTS keeps: %s" % phrase, phrase in A)
for phrase in ["scripts/release minor", "docs/adrs", "docs/releases", "Tests/run.sh", "build.sh", "assets/badges"]:
    check("DEVELOPMENT keeps: %s" % phrase, phrase in D)

# MARK: the security policy (GitHub shows SECURITY.md under the Security tab)
sec = read("SECURITY.md")
check("SECURITY.md exists at the repository root", sec is not None)
S = sec or ""
sl = S.lower()
check("SECURITY.md is between 30 and 100 lines", 30 <= len(S.splitlines()) <= 100, len(S.splitlines()))
check("SECURITY.md has exactly one H1", sum(1 for h in headings(S) if h.startswith("# ")) == 1)
check("SECURITY.md has no emoji", not EMOJI.search(S))
for name, rx in [("Supported versions", r"Supported versions"), ("Reporting a vulnerability", r"Reporting a vulnerability"),
                 ("what to expect", r"What to expect|Response"), ("scope", r"Scope")]:
    check("SECURITY.md has a heading for: %s" % name, any(re.search(rx, h, re.I) for h in headings(S)))
check("SECURITY.md points to the private advisory form", "github.com/gaberger/earshot/security/advisories/new" in S)
check("SECURITY.md says not to open a public issue for a vulnerability", "public issue" in sl)
check("SECURITY.md says only the latest release is supported", "latest release" in sl)
check("SECURITY.md contains no email address", re.search(r"[\w.+-]+@[\w-]+\.[\w.]+", S) is None)
for phrase in ["clipboard", "Accessibility", "MCP", "earshot-speak", "untrusted"]:
    check("SECURITY.md scope covers: %s" % phrase, phrase.lower() in sl)
check("SECURITY.md names what is out of scope, including the app not being notarized", "out of scope" in sl and "notarized" in sl)
check("SECURITY.md describes what to expect without promising a fix date", "acknowledg" in sl and "days" in sl)
check("README links to SECURITY.md", "SECURITY.md" in readme)
check("docs/PRIVACY.md links to the security policy", "SECURITY.md" in P)

# MARK: acknowledgements: credit for inspiration, and notices for what Earshot uses
ack = read("docs/ACKNOWLEDGEMENTS.md")
check("docs/ACKNOWLEDGEMENTS.md exists", ack is not None)
K = ack or ""
kl = K.lower()
check("ACKNOWLEDGEMENTS has exactly one H1", sum(1 for h in headings(K) if h.startswith("# ")) == 1)
check("ACKNOWLEDGEMENTS has no emoji", not EMOJI.search(K))
check("ACKNOWLEDGEMENTS is between 25 and 90 lines", 25 <= len(K.splitlines()) <= 90, len(K.splitlines()))
check("it says Earshot was designed and built on its own", "designed and built on its own" in kl)
check("it says no code was copied", "no code was copied" in kl)
for name in ["OpenSuperWhisper", "Voicebox", "Super Whisper"]:
    check("it thanks: %s" % name, name in K)
for url in ["github.com/my-monkeys/OpenSuperWhisper", "github.com/jamiepine/voicebox", "github.com/ggml-org/whisper.cpp",
            "github.com/k2-fsa/sherpa-onnx", "github.com/snakers4/silero-vad", "github.com/wenet-e2e/wespeaker", "github.com/astral-sh/uv"]:
    check("it links to: %s" % url, url in K)
for comp in ["whisper.cpp", "Silero", "sherpa-onnx", "pyannote", "WeSpeaker", "uv", "ffmpeg", "Foundation Models"]:
    check("the components table lists: %s" % comp, comp.lower() in kl)
check("it states MIT and Apache 2.0 licenses", "mit" in kl and "apache" in kl)
check("it is honest that the WeSpeaker model's own terms are not checked", "wespeaker" in kl and ("not checked" in kl or "unchecked" in kl))
check("it says ffmpeg is installed separately and not bundled", "ffmpeg" in kl and "not bundled" in kl)
check("README links to docs/ACKNOWLEDGEMENTS.md", "docs/ACKNOWLEDGEMENTS.md" in readme)
check("every local link in ACKNOWLEDGEMENTS resolves", all(os.path.exists(os.path.normpath(os.path.join(ROOT, "docs", x.split("#")[0]))) for x in local_targets(K)))

print("%d checks, %d failed" % (checks, failures))
if checks < FLOOR:
    print("VACUOUS: only %d checks ran, need %d" % (checks, FLOOR))
    sys.exit(1)
sys.exit(0 if failures == 0 else 1)
