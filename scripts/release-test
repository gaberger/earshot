#!/usr/bin/env bash
# Gate for scripts/release. Runs it against throwaway git repos; touches nothing real.
# Exit 0 only if every check passed AND at least MIN_CHECKS ran (a run that checks nothing fails).
set -u
SCRIPT="$(cd "$(dirname "$0")" && pwd)/release"
MIN_CHECKS=14
pass=0; fail=0
tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT
export RELEASE_SKIP_TESTS=1 GIT_AUTHOR_NAME=t GIT_AUTHOR_EMAIL=t@t GIT_COMMITTER_NAME=t GIT_COMMITTER_EMAIL=t@t

ok()  { pass=$((pass+1)); echo "  ok   $1"; }
bad() { fail=$((fail+1)); echo "  FAIL $1"; }
expect_ok()   { local name=$1; shift; if "$@" >/dev/null 2>&1; then ok "$name"; else bad "$name"; fi; }
expect_fail() { local name=$1; shift; if "$@" >/dev/null 2>&1; then bad "$name"; else ok "$name"; fi; }

# A repo at 1.0.4 on main with notes for 1.0.5 written but uncommitted.
fresh() {
  local d; d=$(mktemp -d "$tmp/r.XXXX")
  git -C "$d" init -q -b main
  echo 1.0.4 > "$d/VERSION"; mkdir -p "$d/docs/releases"
  git -C "$d" add -A; git -C "$d" commit -q -m init; git -C "$d" tag v1.0.4
  notes "$d" 1.0.5
  echo "$d"
}
notes() { printf -- '- thing\n\nDownload **Earshot-%s.dmg**.\nIt should read `%s`.\n' "$2" "$2" > "$1/docs/releases/$2.md"; }
rel() { local d=$1; shift; (cd "$d" && bash "$SCRIPT" "$@"); }

echo "refusals"
d=$(fresh); git -C "$d" checkout -q -b topic
expect_fail "refuses off main" rel "$d" 1.0.5

d=$(fresh); echo x > "$d/stray"
expect_fail "refuses a dirty tree" rel "$d" 1.0.5

d=$(fresh); rm "$d/docs/releases/1.0.5.md"
expect_fail "refuses missing notes" rel "$d" 1.0.5

d=$(fresh); echo "- thing" > "$d/docs/releases/1.0.5.md"
expect_fail "refuses notes without the dmg name and version" rel "$d" 1.0.5

d=$(fresh); notes "$d" 1.0.4
expect_fail "refuses a version that is not newer" rel "$d" 1.0.4

d=$(fresh)
expect_fail "refuses a malformed version" rel "$d" 1.0

d=$(fresh); git -C "$d" tag v1.0.5
expect_fail "refuses an existing tag" rel "$d" 1.0.5

echo "dry run"
d=$(fresh)
expect_ok "dry run succeeds" rel "$d" 1.0.5 --dry-run
[[ $(cat "$d/VERSION") == 1.0.4 && -z $(git -C "$d" tag -l v1.0.5) ]] && ok "dry run changes nothing" || bad "dry run changes nothing"

echo "release"
d=$(fresh)
expect_ok "patch bump succeeds" rel "$d" patch -m "does a thing"
[[ $(cat "$d/VERSION") == 1.0.5 ]] && ok "VERSION is 1.0.5" || bad "VERSION is 1.0.5"
[[ $(git -C "$d" log -1 --format=%s) == "Release 1.0.5: does a thing" ]] && ok "commit subject" || bad "commit subject"
[[ -n $(git -C "$d" tag -l v1.0.5) && $(git -C "$d" rev-parse v1.0.5^{commit}) == $(git -C "$d" rev-parse HEAD) ]] \
  && ok "tag v1.0.5 points at the release commit" || bad "tag v1.0.5 points at the release commit"
git -C "$d" show --stat --format= HEAD | grep -q 'docs/releases/1.0.5.md' && ok "notes are in the release commit" || bad "notes are in the release commit"
[[ -z $(git -C "$d" status --porcelain) ]] && ok "tree is clean afterwards" || bad "tree is clean afterwards"

d=$(fresh); rm "$d/docs/releases/1.0.5.md"; notes "$d" 1.1.0
rel "$d" minor >/dev/null 2>&1; [[ $(cat "$d/VERSION") == 1.1.0 ]] && ok "minor bump" || bad "minor bump"
d=$(fresh); rm "$d/docs/releases/1.0.5.md"; notes "$d" 2.0.0
rel "$d" major >/dev/null 2>&1; [[ $(cat "$d/VERSION") == 2.0.0 ]] && ok "major bump" || bad "major bump"

echo "push"
d=$(fresh); git init -q --bare "$tmp/remote.git"; git -C "$d" remote add origin "$tmp/remote.git"
expect_ok "--push succeeds" rel "$d" 1.0.5 --push
[[ -n $(git -C "$tmp/remote.git" tag -l v1.0.5) ]] && ok "tag reached the remote" || bad "tag reached the remote"

echo "$pass passed, $fail failed"
if (( pass + fail < MIN_CHECKS )); then echo "VACUOUS: only $((pass+fail)) checks ran, need $MIN_CHECKS" >&2; exit 1; fi
(( fail == 0 ))
